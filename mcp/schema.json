{
  "name": "set_emotion",
  "input_schema": {
    "type": "object",
    "properties": {
      "mood": {
        "type": "string",
        "enum": ["neutral", "calm", "happy", "joy", "amused", "nervous", "sad", "angry"]
      },
      "intensity": { "type": "number" }
    },
    "required": ["mood"]
  }
}